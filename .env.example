APP_NAME=农商行知识问答 Agent
LOG_LEVEL=INFO
# 日志目录：按天切分写入 <LOG_DIR>/app.log，旧文件归档保留 LOG_BACKUP_DAYS 天
LOG_DIR=logs
LOG_BACKUP_DAYS=30
# LLMOps 平台根地址，例如 https://host:30443/llm/llmops
KB_PLATFORM_BASE_URL=http://127.0.0.1:8080
KB_PROJECT_ID=assets
# 租户 id，留空则召回请求不带 tenantId 参数
KB_TENANT_ID=
KB_AUTHORIZATION=
# 召回接口地址（IP/路径待定）：留空按 KB_PLATFORM_BASE_URL 推导默认路径
# FAQ 探测与最终答案检索请求体/响应结构相同，但知识库可能不在同一个网关上，故地址各自可覆盖
# 默认推导值：{KB_PLATFORM_BASE_URL}/applet/api/v1/knowlhub/kbs:mix-retrieve
KB_MIX_RETRIEVE_URL=
# FAQ 探测地址；留空复用 KB_MIX_RETRIEVE_URL（两通道同地址时只配上面那个即可）
KB_FAQ_RETRIEVE_URL=
# 模型服务：每个模型各一条完整地址（含 /chat/completions）与一个密钥，互不覆盖
REWRITE_MODEL_URL=http://77.6.65.47:8099/api/model/chat/completions
REWRITE_MODEL_NAME=Qwen2.5-coder-7B-Instruct
REWRITE_MODEL_KEY=
ANSWER_MODEL_URL=http://77.6.65.47:8099/api/model/75e3041c-7b05-4d8d-a51c-317c470dfc26/chat/completions
ANSWER_MODEL_NAME=Qwen3-32B
ANSWER_MODEL_KEY=
FAQ_SIMILARITY_THRESHOLD=0.98
RETRIEVAL_TOP_K=12
FINAL_CONTEXT_TOP_K=6

# ---- 数据库：术语映射(rag_keywords_mapping)与提示词(rag_prompt) ----
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kb
DB_CHARSET=utf8mb4
DB_POOL_SIZE=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT=5.0
# 映射与提示词的进程内缓存时长（秒），过期后下次请求重新加载
DB_CACHE_TTL_SECONDS=60

# prompt key 映射，与 db.sql 中 rag_prompt 的记录一一对应
# 改写用 query_understanding，最终答案生成用 answer_summary，FAQ 直返润色用 answer_polish
PROMPT_KEY_QUERY_UNDERSTANDING=query_understanding
PROMPT_KEY_ANSWER_SUMMARY=answer_summary
PROMPT_KEY_ANSWER_POLISH=answer_polish
